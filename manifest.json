{
  "manifest_version": 3,
  "name": "ngramIntl — Multi-Test Sync",
  "version": "2.0.0",
  "description": "Capture IKI chirurgicale des n-grams (Monkeytype, TypeRacer, 10FastFingers) vers ngrams-international-3.0.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ngramintl-sync@astralbearcoder.local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ngramIntl Sync"
  },
  "content_scripts": [
    {
      "matches": ["https://monkeytype.com/*"],
      "js": ["core/storage.js", "core/engine.js", "adapters/monkeytype.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.typeracer.com/*"],
      "js": ["core/storage.js", "core/engine.js", "adapters/typeracer.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://10fastfingers.com/*"],
      "js": ["core/storage.js", "core/engine.js", "adapters/10fastfingers.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
